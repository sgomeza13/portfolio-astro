---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { ui } from '../lib/ui';
const t = ui.en;
---
<Base locale="en" title="404">
  <div class="wrap pt-16 lg:pt-24">
    <p class="tab text-[clamp(5rem,16vw,14rem)] font-semibold leading-[0.85] tracking-[-0.05em]">404</p>
    <h1 class="mt-8 border-t-2 border-signal pt-5 text-[clamp(1.75rem,3.5vw,2.75rem)] font-semibold leading-tight tracking-[-0.025em]">{t.notFound}</h1>
    <p class="mt-6 flex flex-wrap gap-x-8 gap-y-2 font-semibold">
      <a href="/" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">{t.notFoundBack} <Arrow /></a>
      <a href="/es/" lang="es" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">{ui.es.notFoundBack} <Arrow /></a>
    </p>
  </div>
</Base>
