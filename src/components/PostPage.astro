---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import type { LocalPost } from '../lib/posts';
import { formatDate, formatPeriod, localePrefix, type Locale } from '../lib/i18n';
import { ui } from '../lib/ui';
import Arrow from './Arrow.astro';

interface Props { post: LocalPost; locale: Locale }
const { post, locale } = Astro.props;
const t = ui[locale];
const { data } = post;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2);
const index = `${localePrefix(locale)}/posts/`;
const links = [
  ...data.repo.map((url, i) => ({ label: data.repo.length > 1 ? `${t.code} ${i + 1}` : t.code, url })),
  ...(data.demo ? [{ label: t.demo, url: data.demo }] : []),
  ...(data.video ? [{ label: t.video, url: data.video }] : []),
];
---

<Base locale={locale} title={data.title} description={data.summary} og={`/og/${post.id}.png`} progress type="article" kind={data.kind}>
  <article class="wrap" data-kind={data.kind}>
    <h1
      class="max-w-[22ch] pt-12 text-[clamp(2.5rem,5.6vw,5.25rem)] font-semibold leading-[1] tracking-[-0.038em] sm:pt-16 lg:pt-24"
      transition:name={`title-${post.id}`}
    >{data.title.replace(/ · /g, '\u00a0· ')}</h1>

    {data.isFallback && locale === 'es' && (
      <p class="mt-8 max-w-[40rem] bg-band px-4 py-3 text-band-ink" lang="es">{t.fallback}</p>
    )}

    <div class="mt-10 grid grid-cols-12 gap-x-6 border-t-2 border-signal pt-6 lg:mt-14 lg:pt-8">
      <aside class="rise col-span-12 lg:col-span-3" style="--i:1">
        <dl class="grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-2 text-[0.9375rem] lg:grid-cols-1 lg:gap-y-0">
          <dt class="text-ink-3">{t.filterKind}</dt>
          <dd class="flex items-start gap-2 font-semibold lg:mb-4"><span class="bullet" aria-hidden="true"></span>{t.kinds[data.kind]}</dd>
          {data.period ? (<>
            <dt class="text-ink-3">{t.meta.period}</dt>
            <dd class="tab lg:mb-4">{formatPeriod(locale, data.period.start, data.period.end)}</dd>
          </>) : (<>
            <dt class="text-ink-3">{t.meta.date}</dt>
            <dd class="lg:mb-4"><time datetime={data.date.toISOString()}>{formatDate(locale, data.date)}</time></dd>
          </>)}
          {data.company && (<>
            <dt class="text-ink-3">{t.meta.company}</dt>
            <dd class="lg:mb-4">{data.company}</dd>
          </>)}
          {data.tags.length > 0 && (<>
            <dt class="text-ink-3">{t.meta.stack}</dt>
            <dd class="lg:mb-4">{data.tags.join(', ')}</dd>
          </>)}
          {links.length > 0 && (<>
            <dt class="text-ink-3">{t.meta.links}</dt>
            <dd class="flex flex-wrap gap-x-4 font-semibold lg:mb-4">
              {links.map((l) => <a href={l.url} class="u inline-flex items-center gap-1 decoration-2 underline-offset-[0.3em]">{l.label} <Arrow dir="out" /></a>)}
            </dd>
          </>)}
        </dl>

        {toc.length > 1 && (
          <nav class="sticky top-8 mt-8 hidden border-t border-rule pt-5 lg:block" aria-label={t.contents}>
            <p class="mb-3 text-[0.9375rem] font-semibold">{t.contents}</p>
            <ol class="space-y-2 text-[0.9375rem] leading-snug">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} class="toc-link flex items-start gap-2 text-ink-2 hover:text-ink" data-slug={h.slug}><span class="bullet" aria-hidden="true"></span>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <div class="col-span-12 mt-10 lg:col-span-8 lg:col-start-4 lg:mt-0">
        <p class="rise max-w-[40rem] text-[1.375rem] leading-[1.45] tracking-[-0.01em]" style="--i:2">{data.summary}</p>
        <div class="body mt-10" lang={data.isFallback ? 'en' : locale}>
          <Content />
        </div>
        <p class="mt-20 border-t-2 border-signal pt-5 font-semibold">
          <a href={index} class="inline-flex items-center gap-2 hover:underline underline-offset-[0.3em]"><Arrow dir="left" /> {t.allPosts}</a>
        </p>
      </div>
    </div>
  </article>
</Base>

<script>
  // The section in view is marked current in the table of contents.
  const wire = () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
    if (!links.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.slug === e.target.id)));
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((l) => {
      const h = document.getElementById(l.dataset.slug!);
      if (h) io.observe(h);
    });
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  };
  document.addEventListener('astro:page-load', wire);
</script>
