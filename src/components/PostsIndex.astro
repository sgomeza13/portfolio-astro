---
import Base from '../layouts/Base.astro';
import PostEntry from './PostEntry.astro';
import { getPosts, kinds } from '../lib/posts';
import type { Locale } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const posts = await getPosts(locale);
const presentKinds = kinds.filter((k) => posts.some((p) => p.data.kind === k));
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b));
const btn = 'inline-flex cursor-pointer items-center gap-2 px-2 py-0.5 -mx-2 text-ink-2 hover:text-ink aria-pressed:bg-signal aria-pressed:text-ground';
---

<Base locale={locale} title={t.postsTitle} description={t.postsIntro}>
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 pt-12 sm:pt-16 lg:pt-24">
      <h1 class="rise col-span-12 text-[clamp(2.75rem,6.4vw,6rem)] font-semibold leading-[0.98] tracking-[-0.04em] lg:col-span-6">{t.postsTitle}</h1>
      <p class="rise col-span-12 mt-6 max-w-[34rem] text-[1.125rem] leading-[1.6] text-ink-2 lg:col-span-6 lg:mt-0 lg:self-end" style="--i:1">{t.postsIntro}</p>
    </div>

    <div class="rise mt-14 space-y-3 border-t-2 border-signal pt-5 text-[0.9375rem]" style="--i:2" data-filters>
      <div class="grid grid-cols-12 items-baseline gap-x-6 gap-y-1">
        <span class="col-span-12 text-ink-3 sm:col-span-2">{t.filterKind}</span>
        <p class="col-span-12 flex flex-wrap items-center gap-x-5 gap-y-1.5 sm:col-span-10">
          <button type="button" class={btn} data-kind="" aria-pressed="true">{t.filterAll}</button>
          {presentKinds.map((k) => <button type="button" class={btn} data-kind={k} aria-pressed="false"><span class="bullet mt-0! size-[0.65em]" data-kind={k} aria-hidden="true"></span>{t.kindsPlural[k]}</button>)}
        </p>
      </div>
      <div class="grid grid-cols-12 items-baseline gap-x-6 gap-y-1">
        <span class="col-span-12 text-ink-3 sm:col-span-2">{t.filterTag}</span>
        <p class="col-span-12 flex flex-wrap items-center gap-x-5 gap-y-1.5 sm:col-span-10">
          {tags.map((tag) => <button type="button" class={`${btn} font-normal`} data-tag={tag} aria-pressed="false">{tag}</button>)}
        </p>
      </div>
    </div>

    <ol class="mt-8 border-t border-rule" data-list>
      {posts.map((p) => <PostEntry post={p} locale={locale} heading="h2" morph wide />)}
    </ol>
    <p class="mt-8 hidden text-ink-2" data-empty>
      {t.noMatch} <button type="button" class="u cursor-pointer underline hover:text-ink" data-clear>{t.clearFilter}</button>
    </p>
  </div>
</Base>

<script>
  // Filters live in the URL (?kind=role&tag=Go) so a filtered list can be linked.
  const wire = () => {
    const root = document.querySelector('[data-filters]');
    if (!root) return;
    const items = [...document.querySelectorAll<HTMLElement>('[data-list] > [data-kind]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const apply = () => {
      const q = new URLSearchParams(location.search);
      const kind = q.get('kind') ?? '';
      const tag = q.get('tag') ?? '';
      root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === kind)));
      root.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      let shown = 0;
      for (const el of items) {
        const ok = (!kind || el.dataset.kind === kind) && (!tag || JSON.parse(el.dataset.tags!).includes(tag));
        el.hidden = !ok;
        shown += Number(ok);
      }
      empty.hidden = shown > 0;
      empty.classList.toggle('hidden', shown > 0);
    };
    const set = (key: string, value: string) => {
      const q = new URLSearchParams(location.search);
      if (value && q.get(key) !== value) q.set(key, value); else q.delete(key);
      history.replaceState(null, '', `${location.pathname}${q.size ? `?${q}` : ''}`);
      apply();
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.dataset.kind !== undefined) set('kind', b.dataset.kind);
      else if (b.dataset.tag) set('tag', b.dataset.tag);
    });
    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      history.replaceState(null, '', location.pathname);
      apply();
    });
    apply();
  };
  document.addEventListener('astro:page-load', wire);
</script>
