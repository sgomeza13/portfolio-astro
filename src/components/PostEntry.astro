---
import type { LocalPost } from '../lib/posts';
import { postHref } from '../lib/posts';
import { monthYear, type Locale } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props {
  post: LocalPost;
  locale: Locale;
  /** Only one element per page may carry a given transition name. */
  morph?: boolean;
  heading?: 'h3' | 'h2';
}

const { post, locale, morph = false, heading: H = 'h3' } = Astro.props;
const t = ui[locale];
const { data } = post;
---

<article class="group relative border-t border-rule py-6">
  <H class="text-[1.375rem] font-semibold leading-snug tracking-[-0.012em]">
    <a
      href={postHref(locale, post.id)}
      class="no-underline after:absolute after:inset-0 group-hover:text-green"
      transition:name={morph ? `title-${post.id}` : undefined}
    >{data.title}</a>
  </H>
  <p class="mt-2 text-ink-2">{data.summary}</p>
  <p class="mt-2 text-[0.875rem] text-ink-3">
    <span class="sc">{t.kinds[data.kind]} · <time datetime={data.date.toISOString()}>{monthYear(locale, data.date)}</time>{data.company && <> · {data.company}</>}</span>
    {data.tags.length > 0 && <span class="italic"> — {data.tags.join(', ')}</span>}
  </p>
</article>
