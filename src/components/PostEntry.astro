---
import type { LocalPost } from '../lib/posts';
import { postHref } from '../lib/posts';
import type { Locale } from '../lib/i18n';
import { ui } from '../lib/ui';
import Row from './Row.astro';

interface Props {
  post: LocalPost;
  locale: Locale;
  /** Only one element per page may carry a given transition name. */
  morph?: boolean;
  heading?: 'h3' | 'h2';
  /** Full-width columns from lg (Posts index) instead of the stacked directory row (home). */
  wide?: boolean;
}

const { post, locale, morph = false, heading = 'h3', wide = false } = Astro.props;
const t = ui[locale];
const { data } = post;
---

<Row
  date={String(data.date.getUTCFullYear())}
  title={data.title}
  summary={data.summary}
  side={[t.kinds[data.kind], data.company].filter(Boolean).join(' · ')}
  kind={data.kind}
  href={postHref(locale, post.id)}
  morph={morph ? `title-${post.id}` : undefined}
  heading={heading}
  wide={wide}
  tags={data.tags}
/>
