---
import Base from '../layouts/Base.astro';
import PostEntry from './PostEntry.astro';
import Arrow from './Arrow.astro';
import Row from './Row.astro';
import { getPosts, postHref, hasCv } from '../lib/posts';
import { formatPeriod, localePrefix, type Locale } from '../lib/i18n';
import { ui, contact } from '../lib/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const posts = await getPosts(locale);

const featured = posts.filter((p) => p.data.featured);
const roles = posts
  .filter((p) => p.data.kind === 'role' && p.data.period)
  .sort((a, b) => b.data.period!.start.valueOf() - a.data.period!.start.valueOf());
const links = [
  { label: t.email, href: `mailto:${contact.email}` },
  { label: 'LinkedIn', href: contact.linkedin, rel: 'me' },
  { label: 'GitHub', href: contact.github, rel: 'me' },
  ...(hasCv ? [{ label: 'CV', href: '/cv.pdf' }] : []),
];
---

<Base locale={locale}>
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 pt-12 sm:pt-16 lg:pt-14">
      <section class="col-span-12 lg:col-span-7 lg:pr-8" aria-labelledby="title">
        <h1 id="title" class="rise text-[clamp(2.75rem,6vw,5.5rem)] font-semibold leading-[0.98] tracking-[-0.04em]" style="--i:0">{t.title}</h1>
        <div class="rise mt-8 lg:mt-10" style="--i:1">
          <p class="text-[1.5rem] font-semibold leading-tight tracking-[-0.015em]">{t.name}</p>
          <p class="mt-1 text-ink-2">{t.tagline} · {t.location}</p>
        </div>
        <p class="rise mt-7 max-w-[38rem] text-[1.125rem] leading-[1.6] text-ink-2" style="--i:2">{t.intro}</p>
        <ul class="rise mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[1.0625rem] font-semibold" style="--i:3">
          {links.map((l) => (
            <li><a href={l.href} rel={l.rel} class="u inline-flex items-center gap-1.5 decoration-2 underline-offset-[0.3em]">{l.label} <Arrow dir="out" /></a></li>
          ))}
        </ul>
      </section>

      {featured.length > 0 && (
        <section class="rise col-span-12 mt-20 lg:col-span-5 lg:mt-3" style="--i:4" aria-labelledby="s-work">
          <h2 id="s-work" class="flex items-baseline justify-between gap-4 border-b-2 border-signal pb-3 text-[1.0625rem] font-semibold">
            {t.sections.work}
            <a href={`${localePrefix(locale)}/posts/`} class="inline-flex items-center gap-1.5 text-[0.9375rem] font-normal text-ink-2 hover:text-ink">{t.allPosts} <Arrow /></a>
          </h2>
          <ol>{featured.map((p) => <PostEntry post={p} locale={locale} morph />)}</ol>
        </section>
      )}
    </div>

    <section class="mt-24 lg:mt-16" aria-labelledby="s-exp">
      <h2 id="s-exp" class="border-b-2 border-signal pb-3 text-[1.0625rem] font-semibold">{t.sections.experience}</h2>
      <ol>
        {roles.map((r) => (
          <Row
            wide
            date={formatPeriod(locale, r.data.period!.start, r.data.period!.end)}
            title={r.data.title}
            summary={r.data.summary}
            side={r.data.company}
            kind="role"
            href={postHref(locale, r.id)}
            morph={featured.includes(r) ? undefined : `title-${r.id}`}
          />
        ))}
        <Row wide date={t.education.year} title={t.education.title} summary={t.education.note} side={t.education.school} />
      </ol>
    </section>
  </div>
</Base>
