---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { alternatePath, localePrefix, type Locale } from '../lib/i18n';
import { ui, contact } from '../lib/ui';
import { hasCv } from '../lib/posts';
import Arrow from '../components/Arrow.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  og?: string;
  progress?: boolean;
  type?: 'website' | 'article';
  /** A Post's Kind: colors its reading-progress bar. */
  kind?: string;
}

const { locale, title, description, og = '/og/default.png', progress = false, type = 'website', kind } = Astro.props;
const t = ui[locale];
const home = `${localePrefix(locale)}/`;
const other: Locale = locale === 'es' ? 'en' : 'es';
const pageTitle = title ? `${title} · ${t.name}` : `${t.name} · Software Engineer`;
const desc = description ?? t.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const onPosts = Astro.url.pathname.includes('/posts/');
// Cloudflare Web Analytics: workers.dev gets no automatic injection, so the beacon is added when a token is set
// (Cloudflare dashboard → Web Analytics → add site → copy token → set PUBLIC_CF_BEACON_TOKEN in the build env).
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(alternatePath(Astro.url.pathname, other), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={t.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e4a3a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17614c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? t.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-grotesk" preload />
    <Font cssVariable="--font-code" />
    <ClientRouter />
    {beacon && <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body class="flex min-h-dvh flex-col">
    {progress && <div class="progress" data-kind={kind} aria-hidden="true"></div>}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 bg-ground px-2 py-1">{t.skip}</a>

    <header class="bg-band text-band-ink">
      <nav class="wrap flex h-14 items-center justify-between gap-6 text-[0.9375rem]" aria-label={t.nav.label}>
        <a href={home} class="whitespace-nowrap font-semibold tracking-[-0.01em]">{t.name}</a>
        <ul class="flex items-center gap-5 sm:gap-8">
          <li><a href={`${localePrefix(locale)}/posts/`} class="underline-offset-[0.4em] hover:underline aria-[current]:underline aria-[current]:decoration-2" aria-current={onPosts ? 'page' : undefined}>{t.nav.posts}</a></li>
          {hasCv && <li><a href="/cv.pdf" class="hover:underline underline-offset-[0.4em]">{t.nav.cv}</a></li>}
          <li>
            <a href={alternatePath(Astro.url.pathname, other)} hreflang={other} lang={other} class="text-band-ink-2 hover:text-band-ink" aria-label={t.nav.switchLabel} data-astro-reload>
              {t.nav.switchTo}
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-band text-band-ink lg:mt-32">
      <div class="wrap flex flex-col-reverse gap-x-8 gap-y-3 py-6 text-[0.9375rem] sm:flex-row sm:items-center sm:justify-between">
        <h2 class="sr-only">{t.contact}</h2>
        <p class="text-band-ink-2">© {new Date().getUTCFullYear()} {t.name} · {t.location}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          <li><a href={`mailto:${contact.email}`} title={contact.email} class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">{t.email} <Arrow dir="out" /></a></li>
          <li><a href={contact.linkedin} rel="me" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">LinkedIn <Arrow dir="out" /></a></li>
          <li><a href={contact.github} rel="me" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">GitHub <Arrow dir="out" /></a></li>
          {hasCv && <li><a href="/cv.pdf" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">CV <Arrow dir="out" /></a></li>}
          <li><a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:underline underline-offset-[0.3em]">RSS <Arrow dir="out" /></a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
