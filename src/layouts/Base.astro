---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { alternatePath, localePrefix, monthYear, type Locale } from '../lib/i18n';
import { ui, contact } from '../lib/ui';
import { hasCv } from '../lib/posts';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  og?: string;
  progress?: boolean;
  type?: 'website' | 'article';
}

const { locale, title, description, og = '/og/default.png', progress = false, type = 'website' } = Astro.props;
const t = ui[locale];
const home = `${localePrefix(locale)}/`;
const other: Locale = locale === 'es' ? 'en' : 'es';
const pageTitle = title ? `${title} · ${t.name}` : `${t.name} · Software Engineer`;
const desc = description ?? t.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const revised = monthYear(locale, new Date(), 'long');
// Cloudflare Web Analytics: workers.dev gets no automatic injection, so the beacon is added when a token is set
// (Cloudflare dashboard → Web Analytics → add site → copy token → set PUBLIC_CF_BEACON_TOKEN in the build env).
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={locale} style={locale === 'es' ? "--fig-label: 'Figura'" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(alternatePath(Astro.url.pathname, other), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={t.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121614" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? t.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" />
    <ClientRouter />
    {beacon && <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body class="min-h-dvh">
    {progress && <div class="progress" aria-hidden="true" transition:persist="progress"></div>}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 bg-paper px-2">{t.skip}</a>

    <header class="paper">
      <nav class="full sc flex items-baseline justify-between gap-4 sm:gap-6 border-b border-rule py-3 text-[0.95rem] text-ink-3" aria-label={t.nav.label}>
        <a href={home} class="no-underline whitespace-nowrap text-ink">
          <span class="sm:hidden">{t.name}</span><span class="hidden sm:inline">{t.name} · {t.runningHead}</span>
        </a>
        <ul class="flex items-baseline gap-3 sm:gap-5">
          <li><a href={`${localePrefix(locale)}/posts/`} class="no-underline">{t.nav.posts}</a></li>
          {hasCv && <li><a href="/cv.pdf" class="no-underline">{t.nav.cv}</a></li>}
          <li>
            <a href={alternatePath(Astro.url.pathname, other)} hreflang={other} lang={other} class="no-underline" aria-label={t.nav.switchLabel} data-astro-reload>
              {t.nav.switchTo}
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="paper mt-28">
      <div class="full border-t border-ink pt-6 pb-12 grid gap-y-4 gap-x-10 text-[0.875rem] leading-relaxed text-ink-2 lg:grid-cols-[10rem_minmax(0,42rem)_1fr]">
        <p class="sc text-ink lg:text-right">{t.correspondence}</p>
        <div>
          <p class="text-ink [overflow-wrap:anywhere]">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>{' · '}
            <a href={contact.linkedin} rel="me">LinkedIn</a>{' · '}
            <a href={contact.github} rel="me">GitHub</a>{' · '}
            <a href="/rss.xml">RSS</a>
          </p>
          <p class="mt-3">{t.revised} {revised}.</p>
        </div>
        <p class="sc lg:text-right lg:whitespace-nowrap">© {new Date().getUTCFullYear()} {t.name}</p>
      </div>
    </footer>
  </body>
</html>
